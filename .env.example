# OpenAI API key (or key for any OpenAI-compatible service)
API_KEY="your-api-key-here"

# Base URL for the OpenAI-compatible API endpoint
# Defaults to https://api.openai.com/v1 if not set
BASE_URL="https://api.openai.com/v1"

# Web search model — always used for the web_search tool regardless of active chat model.
# Must be a search-capable model available on your BASE_URL (e.g. gpt's models).
SEARCH_MODEL="gpt-5"

# ── Global install ───────────────────────────────────────────────────────────
# For a globally-installed `clic`, place this file at ~/.clic/.env so one set of
# credentials works across every project. Precedence (first wins, no override):
#   shell env  >  ./.env (project-local)  >  ~/.clic/.env (global fallback)
#
# CLIC_HOME overrides the global root (default: ~/.clic). Per-project state lives
# under <CLIC_HOME>/projects/<basename>-<hash8>/, keeping project folders clean.
# CLIC_HOME="/custom/path/.clic"
