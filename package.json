{
  "name": "clic",
  "version": "4.3.0",
  "description": "CLIC — Command Line Intelligence Companion. An agentic CLI Like CLAUDE CODE",
  "type": "module",
  "homepage": "https://github.com/UdaySharmaGitHub/CLIC-Agentic-CLI-like-Code-Claude#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UdaySharmaGitHub/CLIC-Agentic-CLI-like-Code-Claude.git"
  },
  "bugs": {
    "url": "https://github.com/UdaySharmaGitHub/CLIC-Agentic-CLI-like-Code-Claude/issues"
  },
  "bin": {
    "clic": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup src/index.ts --format esm --clean",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx test/index.ts",
    "test:zod": "tsx test/index.ts",
    "test:validation-gate": "tsx test/zod-validation.test.ts",
    "test:schemas": "tsx test/tool-schemas.test.ts",
    "test:edge-cases": "tsx test/edge-cases.test.ts",
    "test:watcher": "tsx test/watcher.test.ts",
    "test:privacy": "tsx test/privacy.test.ts",
    "test:export": "tsx test/export.test.ts",
    "test:terminal": "tsx test/terminal.test.ts"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["node-pty"]
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "chalk": "^6.0.1",
    "chokidar": "^5.0.0",
    "commander": "^13.1.0",
    "diff": "^9.0.0",
    "dotenv": "^18.0.5",
    "execa": "^9.5.2",
    "fast-glob": "^3.3.3",
    "node-pty": "^1.1.0",
    "openai": "^6.37.0",
    "ora": "^8.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsup": "^8.4.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
